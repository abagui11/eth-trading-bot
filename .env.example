ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional cheap model for macro/display/critic (defaults to claude-haiku-4-5)
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5
TELEGRAM_BOT_TOKEN=
# Paywall off by default — anyone who /start's gets access. Set true to restrict.
PAYWALL_ENABLED=false
# Required only when PAYWALL_ENABLED=true
ALLOWED_TELEGRAM_IDS=
# Optional: legacy channel or admin monitoring
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
# Audit alerts for rationale / chat hallucinations (private group recommended)
MONITOR_CHAT_ID=
# Macro headline RSS feeds (comma-separated). Defaults: CNBC top news + CoinDesk if unset.
# MACRO_FEED_URLS=https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=100003114,https://www.coindesk.com/arc/outboundfeeds/rss/
# Optional extra T2 keywords (+20 score), e.g. fusaka
# MACRO_KEYWORD_EXTRA=
# Bearer token for POST /api/macro/ingest on dashboard
# MACRO_WEBHOOK_SECRET=
# Perp funding source for the intelligence funding-regime tracker. One of
# okx, bybit, binance. Defaults to okx: Binance (451) and Bybit (403) both
# geo-block the production host. Fallbacks are tried in order and every hop
# is logged; a chain that exhausts logs a FUNDING OUTAGE error.
# FUNDING_SOURCE=okx
# FUNDING_SOURCE_FALLBACKS=bybit,binance
# Internal ops allowlist for gated HQ trade cards (comma-separated Telegram IDs).
# Falls back to ALLOWED_TELEGRAM_IDS, then the admin chat.
# INTERNAL_TELEGRAM_IDS=
# Bearer tokens for service consumers of /api/v1 (yield_gen_bot, trade_ideas).
# Required: every /api/v1 route is token-only and fails closed with 503 when
# this is unset. Comma-separated so consumers can hold distinct tokens.
# SERVICE_API_TOKENS=
# Colocated trade_ideas mill database. The mill sends its idea cards through
# THIS bot's token; the Accept/Reject callbacks land in this process and are
# written here. Must match IDEAS_DB in the mill's .env.
# IDEAS_DB=/opt/trade-ideas/ideas.db
MARKET_DATA_API=https://api.coinbase.com/api/v3/brokerage/market
PORTFOLIO_VALUE=5000
PAPER_PORTFOLIO_VALUE=5000
# Twitter/X announcement posting (HQ trade cards + daily performance digest).
# HQ idea tweets attach the decision-chart PNG when one was rendered.
# Keys come from console.x.com: create a Project + App, set app permissions to
# "Read and write", then copy from Keys and tokens — API Key/Secret (Consumer
# Keys) and Access Token/Secret (for the posting account). New apps use the
# pay-per-use plan (legacy Basic is closed to new signups); load credits or
# posts fail with client-forbidden. Fail-soft: posting no-ops until enabled.
# TWITTER_ENABLED=false
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# Optional OAuth 2.0 Client ID/Secret from User authentication settings
# (not required for the current OAuth 1.0a poster).
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# Public HTTPS URL for Agent journal + My book magic links (no trailing slash)
# DASHBOARD_PUBLIC_URL=https://dashboard.yourdomain.com
DASHBOARD_PORT=8080
# Yield Generation tab: base URL of the yield_gen_bot Next.js app (no trailing
# slash). The hub proxies /api/positions and /api/plan from it, read-only.
# YIELD_GEN_API_URL=http://localhost:3000
# Outbound link for "Open the full yield dashboard" (defaults to the API URL).
# YIELD_GEN_DASHBOARD_URL=

# --- Live execution (Coinbase perps via the Deribit-powered gateway) ---------
# off (default, paper only) | shadow (log would-be orders) | live (real money)
# EXECUTION_MODE=off
# CDP API key from portal.cdp.coinbase.com — View + Trade ONLY, never Transfer.
# COINBASE_CDP_API_KEY_NAME=organizations/xxx/apiKeys/yyy
# Always double-quote the PEM. systemd EnvironmentFile mangles unquoted `\n`
# (strips the backslash) and live JWT signing then fails.
# COINBASE_CDP_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# New gateway base (INTX retires 2026-09-09; default is the Deribit gateway).
# COINBASE_DERIV_API_URL=https://drb.coinbase.com/api/v2
# Critical live alerts (halt / failed stop) also email via Resend when set.
# RESEND_API_KEY=
# ALERT_EMAIL_TO=abagui@republictech.io
# ALERT_EMAIL_FROM=alerts@resend.dev
# Optional HMAC secret for /me links (defaults to TELEGRAM_BOT_TOKEN)
# ME_TOKEN_SECRET=
# ME_TOKEN_TTL_SEC=3600
# ME_SESSION_TTL_SEC=86400
# Gate for the private investor page. Set it, then share
# https://<dashboard>/investors?k=<token> — the first visit sets a cookie and
# every other request 404s. Unset leaves /investors unlisted but open.
# Generate with: openssl rand -hex 16
# INVESTOR_ACCESS_TOKEN=
# INVESTOR_SESSION_TTL_SEC=2592000
